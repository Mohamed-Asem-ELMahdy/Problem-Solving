#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long d;
    cin >> n >> d;

    vector<pair<long long, long long>> vec(n);
    for (int i = 0; i < n; i++) {
        cin >> vec[i].first >> vec[i].second;
    }

    sort(vec.begin(), vec.end());

    long long sum = 0, ans = 0;
    int l = 0;

    for (int r = 0; r < n; r++) {
        sum += vec[r].second;

        while (vec[r].first - vec[l].first >= d) {
            sum -= vec[l++].second;
        }

        ans = max(ans, sum);
    }

    cout << ans ;
    return 0;
}
