#include <bits/stdc++.h>
using namespace std;

bool check(int m, int k,int code) {

    int dom = 0;

    while (code > 0) {
        int val = m / (pow(k,dom)); // 4
        if (val < 1)
            break;
        code -= (val);
        dom++;
    }
    if (code <= 0)
        return true;
    return false;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, k;
    cin >> n >> k;

    int ans = 0, l = 1, r = n;
    while (l <= r) {
        int mid = (l + r) / 2;

        if (check(mid,k,n)) {
            //cout << mid << endl;
            ans = mid;
            r = mid - 1;
        }else {
            l = mid + 1;
        }
    }

    cout << ans << endl;
    return 0;
}
