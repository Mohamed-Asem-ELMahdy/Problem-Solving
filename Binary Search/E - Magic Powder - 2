#include <bits/stdc++.h>
using namespace std;

bool check(long long m, vector<long long> &a, vector<long long> &b, long long powder) {
    long long n = a.size();
    for (int i = 0; i < n; i++) {
        long long need = 1LL * a[i] * m;
        if (need > b[i]) {
            powder -= (need - b[i]);
            if (powder < 0)
                return false;
        }
    }
    return true;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long powder;
    cin >> n >> powder;

    vector<long long> a(n), b(n);

    for (int i = 0; i < n; i++) cin >> a[i];
    for (int i = 0; i < n; i++) cin >> b[i];

    long long ans = 0;
    long long l = 0, r = 2e9;

    while (l <= r) {
        long long m = l + (r - l) / 2;

        if (check(m, a, b, powder)) {
            ans = m;
            l = m + 1;
        } else {
            r = m - 1;
        }
    }

    cout << ans ;
    return 0;
}
