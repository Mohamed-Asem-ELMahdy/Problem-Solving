#include <bits/stdc++.h>
using namespace std;
const int N = 2e5 + 5;
vector<int> cnt(N,0);

bool check(int mid, int k) {
    long long sum = 0;
    for (int i = 1; i < N; i++) {
        sum += cnt[i] / mid;
        if (sum >= k) return true;
    }
    return false;
}


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n,k;
    cin>>n>>k;

    int arr[n];
    for(int i=0;i<n;i++) {
        cin>>arr[i];
        cnt[arr[i]]++;
    }

    int l = 1, r = n/k;
    int mid = 0;
    int ans = 0;
    while(l<=r) {
        mid = (l+r)/2;
        if (check(mid,k)) {
            ans = mid;
            l= mid+1;
        }else {
            r = mid-1;
        }
    }
    //cout << ans << endl;

    vector<int> output;

    int j = 0;
    for (int i= 0; i< N; i++) {
       int count = cnt[i]/ans;
        while (count-- && output.size() < k) {
            output.push_back(i);
        }
    }
    for (auto i: output) {
        cout<<i<<" ";
    }
    return 0;
}
