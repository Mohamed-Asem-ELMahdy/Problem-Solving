#include <bits/stdc++.h>
using namespace std;

bool check(int mid, int arr[], int k, int n) {
    int count = 0;
    int i = 0, j = 0;

    while (i < n) {
        int accept = arr[i]+mid-1;
        j = i + 1;
        while (arr[j] <= accept && j < n) {
            j++;
        }
        count++;
        i = j;
    }
    return count <= k;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n,k;
        cin >> n >> k;
        int a[n];
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        int l = 1, r = a[n-1] ;
        int ans = -1;

        while (l <= r) {
            int mid = (l + r) / 2;
            if (check(mid, a, k, n)) {
                ans = mid;
                r = mid - 1;
            }
            else {
                l = mid + 1;
            }
        }
        cout << ans << endl;
    }


    return 0;
}
