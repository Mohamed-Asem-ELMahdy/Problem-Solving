#include <bits/stdc++.h>
using namespace std;

bool check(long long mid,long long arr[], long long crr[], long long n, long long m) {

    long long j = 0;
    for (long long i = 0; i < n; i++) {
        while(j<m && crr[j] < arr[i]-mid) {
            j++;
        }
        if (j == m) return false;

        if (llabs(arr[i] - crr[j]) > mid ) {
            return false;
        }
    }
    return true;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long n,m;
    cin>>n>>m;

    long long arr [n], crr[m];
    for(long long i=0;i<n;i++) {
        cin>>arr[i];

    }

    for(long long i=0;i<m;i++) {
        cin>>crr[i];
    }

    long long l = 0, r = 2e9;
    long long ans = 0;
    while(l <= r) {
        long long mid = (l + r) / 2;

        if (check(mid, arr, crr, n,m)) {
            r = mid - 1 ;
            ans = mid;
        }
        else {
            l = mid + 1;
        }
    }
    cout << ans << endl;

    return 0;
}
