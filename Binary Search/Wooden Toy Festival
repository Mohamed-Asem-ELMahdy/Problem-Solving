#include <bits/stdc++.h>
using namespace std;

bool check(long long mid, long long arr[], long long n) {

    long long count = 0;

    int i = 0;
    while (i<n) {   
        long long start = arr[i];
        while (i<n && arr[i] - start <= 2*mid) {
            i++;
        }
        count++;
    }

    return count <= 3;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        long long n;
        cin>>n;

        long long arr[n];
        for (long long i=0;i<n;i++) {
            cin>>arr[i];
        }

        sort(arr,arr+n);

        long long l = 0, r = arr[n-1];
        long long ans = 0;

        while (l<=r) {
            long long mid = (l+r)/2;
            if (check(mid,arr,n)) {
                ans = mid;
                r = mid-1;
            }else {
                l = mid+1;
            }
        }

        cout << ans << endl;
    }
    return 0;
}
