#include <bits/stdc++.h>
using namespace std;

long long s;

long long check(int m, vector<int>& v) {
    long long sum = 0;
    int n = (int)v.size();

    vector<long long> a(n);
    for (int i = 0; i < n; i++) {
        a[i] = 1LL * v[i] + 1LL * (i + 1) * m;  
    }

    sort(a.begin(), a.end());

    for (int i = 0; i < m; i++) {
        sum += a[i];
    }

    return sum;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n >> s;

    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int l = 0, r = n;   // allow m = 0
    int ans = 0;
    long long sum = 0;

    while (l <= r) {
        int m = (l + r) / 2;
        sum = check(m, a);

        if (sum <= s) {
            ans = m;
            l = m + 1;
        } else {
            r = m - 1;
        }
    }

    cout << ans << " " << check(ans, a) ;
    return 0;
}
