#include <bits/stdc++.h>
using namespace std;

const int N = 2e5;
pair<bool,int> check(int m, int arr[], int k, int a,int n) {

    // cout <<"-------------------"<<endl;
    // cout << m << endl;
    vector<char> vec(N,'0');
    for(int i=0;i<m;i++) {
        vec[arr[i]-1] = 'x';
    }
    //  for(int i=0;i<n;i++) {
    //      cout << vec[i] << " ";
    //  }
    // cout << endl;

    int p = 0;
    int count = 0;
    for(int i=0;i<n;i++) {
        if (vec[i] != 'x') {
            p++;
        }else p = 0;
        if (p == a) {
            count ++;
            p=0;
            i++;
        }
    }
   // cout << count << endl;
    if (count >= k)
        return {true,count};
    else return {false,count};
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n,k,a;
    cin>> n >> k >> a;
    int m;
    cin>> m;

    int arr[m];
    for(int i=0;i<m;i++) {
        cin>>arr[i];
    }

    int ans =-1;
    int l = 0, r = m;
    while(l <= r) {
        int mid = (l+r)/2;
       //cout <<l<<" "<<r<<endl;
        auto val = check(mid,arr,k,a,n);
        if (val.first) {
            ans = mid ;
            l = mid+1;
        }else {
            r = mid-1;
        }
     }
    if (ans == m) {
        cout << -1;
    }else
        cout << ++ans;


    return 0;
}
