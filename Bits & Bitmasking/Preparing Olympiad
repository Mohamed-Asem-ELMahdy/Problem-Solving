#include <bits/stdc++.h>
#define isBitOn(n,k) ( (n>>k) & 1)
#define setBitOn(n,k) (n|=(1<<k))
#define clrBitOn(n,k) (n&=~(1<<k))
// __builtin_ctzll(x)  ->  count trailing zeros
// __builtin_popcountll(x) -> count all setbits
// 63-__builtin_clzll(x) -> idx of highest setbit
using namespace std;


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n,l,r,x;
    cin>>n>>l>>r>>x;

    int arr[n];

    for(int i=0;i<n;i++) {
        cin>>arr[i];
    }


    int diff = 0, count = 0;
    for (int i=0;i < (1<<n);i++) {
        int mx = INT_MIN;
        int mn = INT_MAX;
        diff = 0;
        int sum = 0;
        int c = 0;
        for (int j = 0;j < n;j++) {
            if (isBitOn(i,j)) {
                mx = max(mx,arr[j]);
                mn = min(mn,arr[j]);
                sum += arr[j];
                c++;
            }
        }
        diff = mx-mn;
        if (c >= 2 && sum <= r && sum >= l && diff >= x) {
            count ++;
        }
    }

    cout<<count;

    return 0;
}
