#include <bits/stdc++.h>
#define isBitOn(n,k) ( (n>>k) & 1)
#define setBitOn(n,k) (n|=(1<<k))
#define clrBitOn(n,k) (n&=~(1<<k))
// __builtin_ctzll(x)  ->  count trailing zeros
// __builtin_popcountll(x) -> count all setbits
// 63-__builtin_clzll(x) -> idx of highest setbit
using namespace std;


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin>>t;
    while(t--) {
        string s;
        cin>>s;

        bool flag = 1;
        int count = 0;

        for(int i=0;i<s.size();i++) {

            if (s[i] == '0' && flag) {
                count++;
                flag = 0;
            }else if (s[i] == '1' ) {
                flag = 1;
            }
        }

        if (count >= 2) cout<<2<<endl;
        else cout<<count<<endl;
    }


    return 0;
}
