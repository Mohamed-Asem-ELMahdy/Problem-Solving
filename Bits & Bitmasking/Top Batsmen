#include <bits/stdc++.h>
#define isBitOn(n,k) ( (n>>k) & 1)
#define setBitOn(n,k) (n|=(1<<k))
#define clrBitOn(n,k) (n&=~(1<<k))
// __builtin_ctzll(x)  ->  count trailing zeros
// __builtin_popcountll(x) -> count all setbits
// 63-__builtin_clzll(x) -> idx of highest setbit
using namespace std;


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin>>t;
    while(t--) {

        int arr[12];
        for(int i=0;i<11;i++)
            cin>>arr[i];

        int k ;
        cin>>k;

        sort(arr,arr+11);
        int sum = 0;
        for (int i = 10 ;i >= 11-k;i--) {
            sum += arr[i];
        }

        int ans = 0;
        for (int i = 0 ; i < (1<<11) ; i++) {
            int count = 0;
            int sum2 = 0 ;
            for (int j =0 ; j< 11; j++) {
                if (isBitOn(i,j)) {
                    count ++;
                    sum2 += arr[j];
                }
            }

            if (count == k && sum == sum2) {
                ans ++;
            }
        }
        cout<<ans<<endl;
    }

    return 0;
}
