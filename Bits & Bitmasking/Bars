#include <bits/stdc++.h>
#define isBitOn(n,k) ( (n>>k) & 1)
#define setBitOn(n,k) (n|=(1<<k))
#define clrBitOn(n,k) (n&=~(1<<k))
// __builtin_ctzll(x)  ->  count trailing zeros
// __builtin_popcountll(x) -> count all setbits
// 63-__builtin_clzll(x) -> idx of highest setbit
using namespace std;


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin>>t;
    ex:
    while(t--) {

        int n;
        cin>>n;

        int p;
        cin>>p;

        int arr[p];
        for(int i=0;i<p;i++) {
            cin>>arr[i];
        }

       for(int i=0;i<(1<<p);i++) {
           int sum = 0;
           for (int j = 0; j < p; j++) {
               if (isBitOn(i,j)) {
                   sum += arr[j];
               }
           }
           if (sum == n) {
               cout<<"YES"<<endl;
               goto ex;
           }
       }
        cout<<"NO"<<endl;
    }
    return 0;
}
