#include <bits/stdc++.h>
#define isBitOn(n,k) ( (n>>k) & 1)
#define setBitOn(n,k) (n|=(1<<k))
#define clrBitOn(n,k) (n&=~(1<<k))
// __builtin_ctzll(x)  ->  count trailing zeros
// __builtin_popcountll(x) -> count all setbits
// 63-__builtin_clzll(x) -> idx of highest setbit
const long long MOD = 998244353LL;
using namespace std;


int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long t;
    cin>>t;
    ex:
    while(t--) {

        long long n;
        cin >> n;

        long long count = 0;
        long long ans = 1;
        vector<long long> odd,even;
        for (long long i = 0; i < n; i++) {
            long long x; cin >> x;
            if (x == 1) {
                count ++;
            }else if (x % 2 == 0) {
                even.push_back(x);
            }else {
                odd.push_back(x);
            }
        }

        sort(even.begin(), even.end());


        for (auto x : odd) {
            ans = (ans * (x%MOD))%MOD;
        }
        for (auto x : even) {
            if (count > 0) {
                long long num = x ^ 1;
                ans = (ans * (num%MOD))%MOD;
                count -= 1;
            }else {
                ans = (ans * (x%MOD))%MOD;
            }
        }
        cout << ans % MOD << endl;

    }
    return 0;
}
