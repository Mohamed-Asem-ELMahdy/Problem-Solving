#include <bits/stdc++.h>
using namespace std;
 
vector<pair<int,int>> dir = {
    {1,0}, {-1,0}, {0,1}, {0,-1}
};
 
char signs[] = {'D','U','R','L'};
 
char graph[1001][1001], par[1001][1001];
int dis[1001][1001];
 
int main() {
 
    int n,m;
    cin >> n >> m;
 
    pair<int,int> start,end;
    for(int i=0;i<n;i++) {
        for(int j=0;j<m;j++) {
            cin >> graph[i][j];
            dis[i][j] = -1;
 
            if (graph[i][j] == 'A')
                start = {i,j};
            if (graph[i][j] == 'B')
                end = {i,j};
        }
    }
 
    queue<pair<int,int>> q;
    q.push(start);
    dis[start.first][start.second] = 0;
 
    while(!q.empty()) {
        auto curr = q.front();
        q.pop();
 
        for (int i=0;i<4;i++) {
            auto [dx,dy] = dir[i];
            int nx = curr.first + dx;
            int ny = curr.second + dy;
 
            if (nx >= 0 && nx < n && ny >= 0 && ny < m &&
                graph[nx][ny] != '#' && dis[nx][ny] == -1) {
 
                dis[nx][ny] = dis[curr.first][curr.second] + 1;
                par[nx][ny] = signs[i];
                q.push({nx,ny});
                }
        }
    }
 
    if (dis[end.first][end.second] == -1) {
        cout << "NO\n";
        return 0;
    }
 
    string road = "";
    int x = end.first, y = end.second;
 
    while(make_pair(x,y) != start) {
        char c = par[x][y];
        road += c;
 
        if (c == 'D') x--;
        else if (c == 'U') x++;
        else if (c == 'R') y--;
        else if (c == 'L') y++;
    }
 
    reverse(road.begin(), road.end());
 
    cout << "YES\n";
    cout << dis[end.first][end.second] << "\n";
    cout << road << "\n";
}
