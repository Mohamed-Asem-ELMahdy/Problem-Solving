#include <bits/stdc++.h>
using namespace std;
 
const int MAXN = 1e5+1;
vector<vector<int>> graph(MAXN, vector<int>());
vector<int> dist(MAXN);
vector<int> path(MAXN);vector<bool> vis(MAXN);
 
int main() {
 
    int n, m;
    cin >> n >> m;
 
 
    for (int i = 0; i < m; i++) {
        int x, y;
        cin >> x >> y;
        graph[x].push_back(y);
        graph[y].push_back(x);
    }
 
    queue<int> q;
    q.push(1);
    dist[1] = 1;
    vis[1] = true;
 
    while (!q.empty()) {
        int x = q.front();
        q.pop();
        for (auto v : graph[x]) {
            if (! vis[v]) {
                vis[v] = true;
                dist[v] = dist[x] + 1;
                path[v] = x;
                q.push(v);
            }
        }
    }
 
    if (!vis[n]) {
        cout << "IMPOSSIBLE";
        return 0;
    }
 
    int cnt  = dist[n];
 
    int node = n;
 
    cout << cnt << endl;
 
    vector<int> ans;
    while (cnt--) {
        ans.push_back(node);
        if (node == 1) break;
        node = path[node];
    }
 
    reverse(ans.begin(), ans.end());
    for (auto v : ans) {
        cout << v << " ";
    }
 
}
