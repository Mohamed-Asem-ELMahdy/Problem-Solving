#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> vec(n);
    for (int i = 0; i < n; i++) cin >> vec[i];

    set<int> st;
    int l = 0;
    int max_len = 0;

    for (int r = 0; r < n; r++) {
        while (st.count(vec[r])) {
            st.erase(vec[l]);
            l++;
        }
        st.insert(vec[r]);
        max_len = max(max_len, r - l + 1);
    }

    cout << max_len ;
    return 0;
}
