#include <iostream>
#include<bits/stdc++.h>
using namespace std;

int main()
{
   int n,time;
   cin>>n>>time;
   vector<int> vec(n);
   for(int i=0;i<n;i++){
       cin>>vec[i];
   }

   int mx =-1,sum = 0;
   int l=0,r=0;

   while(r<n){
       sum+=vec[r];

       while(sum>time){
           sum-=vec[l];
           l++;
       }
       mx = max(r-l+1,mx);
       r++;
   }
   cout<<mx;



    return 0;
}
